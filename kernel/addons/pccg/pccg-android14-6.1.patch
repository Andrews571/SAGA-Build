diff --git a/kernel/sched/cpufreq_pccg.c b/kernel/sched/cpufreq_pccg.c
new file mode 100644
index 000000000..fd80021e6
--- /dev/null
+++ b/kernel/sched/cpufreq_pccg.c
@@ -0,0 +1,1136 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SAGA PCCG (Pre CPU Clutch Governor) — CPUFreq governor
+ *
+ * The "go all in" sibling of REFLEX (cpufreq_reflex.c): same idle-time
+ * hispeed floor mechanism, taken further in every direction Reflex was
+ * deliberately conservative about, inspired by (not ported from --
+ * everything here is written from scratch against 6.1's real cpufreq/
+ * scheduler internals) Apple's Clutch/Edge scheduler concepts introduced
+ * with iOS 27 (apple-oss-distributions/xnu, doc/scheduler/
+ * sched_clutch_edge.md):
+ *
+ *   - SELF-SUFFICIENT: needs nothing beyond what every 6.1 GKI kernel
+ *     already has. Its primary "this CPU just became busy" signal is a
+ *     plain rq->nr_running 0->1 edge (pccg_wake_edge_check() below) --
+ *     no BORE, no NO_HZ, no EAS, no sched_ext required. Works exactly as
+ *     well on a kernel with none of the other SAGA addons applied.
+ *   - ENHANCED WHEN AVAILABLE: if CONFIG_SCHED_BORE is present, also
+ *     takes the BORE burst_penalty hint Reflex already used (see
+ *     pccg_bore_check()) as a second, independent trigger. Neither path
+ *     depends on the other; either alone is enough to drive the floor.
+ *   - MORE AGGRESSIVE BY DEFAULT: hispeed_freq_pct defaults to 100 (a
+ *     full jump to policy max on trigger, same as upstream Reflex),
+ *     versus REFLEX's deliberately gentler 70.
+ *   - CAPACITY-AWARE: pccg_target_util() scales the effective jump
+ *     percentage by each CPU's own arch_scale_cpu_capacity() -- a small
+ *     LITTLE core still gets close to a full jump (its absolute Hz jump
+ *     is modest regardless), while a big/prime core's jump is tempered
+ *     towards whatever hispeed_freq_pct is actually set to, instead of
+ *     always slamming every cluster to the same flat percentage.
+ *
+ * Everything else (idle-time sampling via get_cpu_idle_time(), the hold/
+ * decay hysteresis, iowait boost, fast-switch/adjust_perf paths) is
+ * identical to REFLEX and, transitively, to schedutil -- see
+ * cpufreq_reflex.c's header for why each of those pieces is safe to
+ * reuse unchanged on 6.1.
+ *
+ * NOT included: an actual Clutch-style scheduling class (hierarchical
+ * QoS-bucket EDF, thread-group interactivity scoring, cross-cluster
+ * "Edge" placement). That is scheduler-core surgery, not governor work,
+ * and is deliberately out of scope here -- see the SAGA-Build addon
+ * README for bore-warp (kernel/addons/bore-warp/), which is the
+ * intentionally-small, intentionally-off-by-default piece of that idea
+ * that *was* judged safe to ship this way.
+ *
+ * All tunables are per-policy sysfs knobs (same gov_attr_set mechanism
+ * schedutil/reflex use), so a single kernel build stays usable across
+ * any android14-6.1 device: /sys/devices/system/cpu/cpufreq/policyN/pccg/
+ */
+
+#define IOWAIT_BOOST_MIN	(SCHED_CAPACITY_SCALE / 8)
+
+/* SCHED_FLAG_SUGOV is private to kernel/sched/sched.h; already visible here
+ * since this file is #included from build_utility.c after sched.h. */
+
+struct pccg_tunables {
+	struct gov_attr_set	attr_set;
+	unsigned int		rate_limit_us;
+
+	/* Observation window for the real busy% sample (usec). This is now
+	 * a backstop/confirmation path, not the primary trigger -- the
+	 * wake-edge and (if present) BORE checks below fire immediately on
+	 * their own signals, faster than any window could. Kept the same
+	 * 8ms as REFLEX for the cases neither of those catches. */
+	unsigned int		hispeed_window_us;
+
+	/* Busy% (0-100) over hispeed_window_us above which the floor snaps
+	 * to hispeed_freq_pct, for whatever the wake-edge/BORE paths missed. */
+	unsigned int		hispeed_load_pct;
+
+	/* Where the floor lands when triggered, as a percentage of the
+	 * policy's max capacity -- BEFORE pccg_target_util()'s per-CPU
+	 * capacity scaling is applied (see file header). 100 = full jump,
+	 * PCCG's default; REFLEX defaults to 70 for the same knob. */
+	unsigned int		hispeed_freq_pct;
+
+	/* Geometric decay: each window, the floor is reduced by
+	 * floor >>= hispeed_decay_shift. */
+	unsigned int		hispeed_decay_shift;
+
+	/* Hold time (usec) after the floor last triggered before decay is
+	 * allowed to start. See REFLEX's identical knob for the rationale
+	 * (scroll gestures with gaps longer than one window). */
+	unsigned int		hispeed_hold_us;
+
+	/* Self-sufficient primary trigger: fire the floor the instant this
+	 * CPU's rq->nr_running goes 0->1 (see pccg_wake_edge_check()). No
+	 * dependency on anything beyond the core scheduler. 1 = on
+	 * (default), 0 = disable this path (pure idle-time + BORE, if
+	 * present). */
+	unsigned int		wake_edge_boost;
+
+	/* Scale the effective jump percentage by each CPU's own capacity
+	 * (see pccg_target_util()) instead of applying hispeed_freq_pct
+	 * flat across every cluster. 1 = on (default), 0 = flat like
+	 * REFLEX. */
+	unsigned int		auto_capacity_scale;
+
+#ifdef CONFIG_SCHED_BORE
+	/* Optional second early trigger: see the identical knob in
+	 * cpufreq_reflex.c for the full rationale. Independent of, and
+	 * redundant with, wake_edge_boost above -- either alone already
+	 * covers the "just woke up" case; this adds BORE's own freshness
+	 * classification as a second opinion, useful mainly for the
+	 * "curr is a CPU hog, pse is fresh" case where nr_running was
+	 * already nonzero (no 0->1 edge) but the CPU still just started
+	 * doing meaningfully different work. */
+	unsigned int		bore_boost_max_score;
+#endif
+};
+
+struct pccg_policy {
+	struct cpufreq_policy	*policy;
+
+	struct pccg_tunables	*tunables;
+	struct list_head	tunables_hook;
+
+	raw_spinlock_t		update_lock;
+	u64			last_freq_update_time;
+	s64			freq_update_delay_ns;
+	unsigned int		next_freq;
+	unsigned int		cached_raw_freq;
+
+	/* The next fields are only needed if fast switch cannot be used: */
+	struct			irq_work irq_work;
+	struct			kthread_work work;
+	struct			mutex work_lock;
+	struct			kthread_worker worker;
+	struct task_struct	*thread;
+	bool			work_in_progress;
+
+	bool			limits_changed;
+	bool			need_freq_update;
+};
+
+struct pccg_cpu {
+	struct update_util_data	update_util;
+	struct pccg_policy	*pccg_policy;
+	unsigned int		cpu;
+
+	bool			iowait_boost_pending;
+	unsigned int		iowait_boost;
+	u64			last_update;
+
+	unsigned long		util;
+	unsigned long		bw_dl;
+	unsigned long		max;
+
+	/* Hispeed floor state (idle-time based, see file header) */
+	u64			hispeed_prev_idle_time;
+	u64			hispeed_prev_wall_time;
+	u64			hispeed_next_sample_time;
+	unsigned long		hispeed_floor;	/* capacity units, decays */
+	u64			hispeed_hold_until;	/* ns; decay gated until this */
+
+	/* Self-sufficient wake-edge detector state (see
+	 * pccg_wake_edge_check()). No CONFIG dependency at all -- plain
+	 * rq->nr_running is always present. */
+	unsigned int		prev_nr_running;
+
+	/* The field below is for single-CPU policies only: */
+#ifdef CONFIG_NO_HZ_COMMON
+	unsigned long		saved_idle_calls;
+#endif
+};
+
+static DEFINE_PER_CPU(struct pccg_cpu, pccg_cpu_data);
+
+/************************ Governor internals ***********************/
+
+static bool pccg_should_update_freq(struct pccg_policy *pccg_policy, u64 time)
+{
+	s64 delta_ns;
+
+	if (!cpufreq_this_cpu_can_update(pccg_policy->policy))
+		return false;
+
+	if (unlikely(READ_ONCE(pccg_policy->limits_changed))) {
+		WRITE_ONCE(pccg_policy->limits_changed, false);
+		pccg_policy->need_freq_update = true;
+		smp_mb();
+		return true;
+	}
+
+	delta_ns = time - pccg_policy->last_freq_update_time;
+
+	return delta_ns >= pccg_policy->freq_update_delay_ns;
+}
+
+static bool pccg_update_next_freq(struct pccg_policy *pccg_policy, u64 time,
+				  unsigned int next_freq)
+{
+	if (pccg_policy->need_freq_update) {
+		pccg_policy->need_freq_update = false;
+		if (pccg_policy->next_freq == next_freq &&
+		    !cpufreq_driver_test_flags(CPUFREQ_NEED_UPDATE_LIMITS))
+			return false;
+	} else if (pccg_policy->next_freq == next_freq) {
+		return false;
+	}
+
+	pccg_policy->next_freq = next_freq;
+	pccg_policy->last_freq_update_time = time;
+
+	return true;
+}
+
+static void pccg_deferred_update(struct pccg_policy *pccg_policy)
+{
+	if (!pccg_policy->work_in_progress) {
+		pccg_policy->work_in_progress = true;
+		irq_work_queue(&pccg_policy->irq_work);
+	}
+}
+
+/* Identical mapping to schedutil's get_next_freq() (same 1.25x DVFS
+ * headroom, same frequency-invariance handling) — only the @util fed in
+ * differs (max(pelt_util, hispeed_floor) instead of plain pelt_util). */
+static unsigned int pccg_get_next_freq(struct pccg_policy *pccg_policy,
+				       unsigned long util, unsigned long max)
+{
+	struct cpufreq_policy *policy = pccg_policy->policy;
+	unsigned int freq = arch_scale_freq_invariant() ?
+				policy->cpuinfo.max_freq : policy->cur;
+
+	util = map_util_perf(util);
+	freq = map_util_freq(util, freq, max);
+
+	if (freq == pccg_policy->cached_raw_freq && !pccg_policy->need_freq_update)
+		return pccg_policy->next_freq;
+
+	pccg_policy->cached_raw_freq = freq;
+	return cpufreq_driver_resolve_freq(policy, freq);
+}
+
+/*
+ * pccg_update_hispeed() - sample real busy% since the last window and fold
+ * it into the decaying floor.
+ *
+ * Runs at most once per hispeed_window_us per CPU — cheap on the common
+ * "already sampled this window" path (one u64 compare), so calling it from
+ * every update_util callback (same call frequency schedutil already runs
+ * at) is fine.
+ */
+/*
+ * pccg_target_util() - where the floor should land for this CPU, given the
+ * configured hispeed_freq_pct and (if enabled) this CPU's own relative
+ * capacity.
+ *
+ * arch_scale_cpu_capacity() already returns a value normalized against
+ * SCHED_CAPACITY_SCALE (1024) system-wide -- the biggest/fastest core in
+ * the system sits at (close to) 1024, smaller cores proportionally lower
+ * (a Cortex-A55 next to a Cortex-A78 typically lands around 400-550). That
+ * ratio is exactly "how big is this core", already computed by the
+ * scheduler for EAS -- no extra bookkeeping needed to use it here.
+ *
+ * With auto_capacity_scale on, a core's effective jump percentage is
+ * pulled up towards 100 the smaller its relative capacity is, leaving
+ * hispeed_freq_pct as configured only for the single biggest core in the
+ * system (cap == SCHED_CAPACITY_SCALE exactly -> no adjustment). The
+ * reasoning: hispeed_freq_pct=70 is a very different absolute jump (and a
+ * very different power cost) on a Cortex-X-class prime core than on an
+ * A55 -- the same flat percentage applied to every cluster either
+ * overshoots the LITTLE cores' power budget or undershoots their latency
+ * benefit, depending which cluster you calibrated it for.
+ */
+static unsigned long pccg_target_util(struct pccg_cpu *pccg_cpu, unsigned long cap)
+{
+	struct pccg_tunables *tunables = pccg_cpu->pccg_policy->tunables;
+	unsigned int pct = tunables->hispeed_freq_pct;
+
+	if (tunables->auto_capacity_scale) {
+		unsigned int gap = SCHED_CAPACITY_SCALE - min(cap, (unsigned long)SCHED_CAPACITY_SCALE);
+
+		pct += ((100 - pct) * gap) / SCHED_CAPACITY_SCALE;
+	}
+
+	return (cap * pct) / 100;
+}
+
+static void pccg_hispeed_raise(struct pccg_cpu *pccg_cpu, u64 time_ns,
+			       unsigned long target)
+{
+	struct pccg_tunables *tunables = pccg_cpu->pccg_policy->tunables;
+
+	if (target > pccg_cpu->hispeed_floor)
+		pccg_cpu->hispeed_floor = target;
+
+	/* Push the earliest-allowed-decay point out every time something
+	 * re-triggers the floor, so a steady stream of touch events (with
+	 * gaps longer than one window but shorter than the hold) keeps the
+	 * floor pinned instead of sawtoothing between two OPPs. */
+	pccg_cpu->hispeed_hold_until = time_ns +
+		(u64)tunables->hispeed_hold_us * NSEC_PER_USEC;
+}
+
+static void pccg_update_hispeed(struct pccg_cpu *pccg_cpu, u64 time_ns)
+{
+	struct pccg_tunables *tunables = pccg_cpu->pccg_policy->tunables;
+	u64 wall_us, idle_us, delta_wall, delta_idle, busy_pct;
+	unsigned long cap;
+	bool held = time_ns < pccg_cpu->hispeed_hold_until;
+
+	if (time_ns < pccg_cpu->hispeed_next_sample_time)
+		return;
+
+	idle_us = get_cpu_idle_time(pccg_cpu->cpu, &wall_us, 0);
+
+	delta_wall = wall_us - pccg_cpu->hispeed_prev_wall_time;
+	delta_idle = idle_us - pccg_cpu->hispeed_prev_idle_time;
+
+	pccg_cpu->hispeed_prev_wall_time = wall_us;
+	pccg_cpu->hispeed_prev_idle_time = idle_us;
+	pccg_cpu->hispeed_next_sample_time = time_ns +
+		(u64)tunables->hispeed_window_us * NSEC_PER_USEC;
+
+	/* First sample after start/hotplug, clock went backwards, or a
+	 * suspend/resume-sized jump landed between two samples (delta_wall
+	 * wraps huge as an unsigned subtraction if wall_us regressed, which
+	 * a bare "delta_idle > delta_wall" check does not reliably catch
+	 * once both sides have wrapped): skip this window rather than
+	 * compute garbage from it. Bounding delta_wall to a few windows'
+	 * worth is enough slack for normal scheduling jitter while still
+	 * rejecting a wrapped/bogus value. */
+	if (unlikely(!delta_wall || delta_idle > delta_wall ||
+		     delta_wall > (u64)tunables->hispeed_window_us * 4)) {
+		if (!held)
+			pccg_cpu->hispeed_floor >>= tunables->hispeed_decay_shift;
+		return;
+	}
+
+	/* Plain u64 division: deltas are microseconds within one window
+	 * (default 8000us), nowhere near needing div64_u64's 32-bit-divisor
+	 * fast path, and no extra header dependency this way. */
+	busy_pct = ((delta_wall - delta_idle) * 100) / delta_wall;
+	cap = arch_scale_cpu_capacity(pccg_cpu->cpu);
+
+	if (busy_pct >= tunables->hispeed_load_pct) {
+		pccg_hispeed_raise(pccg_cpu, time_ns, pccg_target_util(pccg_cpu, cap));
+	} else if (!held) {
+		pccg_cpu->hispeed_floor >>= tunables->hispeed_decay_shift;
+	}
+}
+
+#ifdef CONFIG_SCHED_BORE
+/*
+ * pccg_bore_check() - early hispeed trigger from BORE's own burst
+ * classification, instead of waiting for the idle-time window to confirm
+ * the same thing after the fact.
+ *
+ * BORE tags every sched_entity with a burst_penalty score (0-39, see
+ * kernel/sched/fair.c calc_burst_score()) that goes up the longer a task
+ * has been hogging the CPU since its last sleep, and resets to a low value
+ * on wake. A task currently running with a low score is, by BORE's own
+ * definition, one it just classified as fresh/interactive rather than a
+ * CPU hog -- available the instant that task starts running, strictly
+ * earlier than hispeed_window_us of idle-time can confirm the CPU turned
+ * busy. Runs on every pccg_get_util() call (cheap: one struct field read
+ * under the rq lock update_util callbacks already hold), not gated by the
+ * window, since there is no expensive syscall-like read involved here
+ * unlike get_cpu_idle_time().
+ */
+static void pccg_bore_check(struct pccg_cpu *pccg_cpu, u64 time_ns)
+{
+	struct pccg_tunables *tunables = pccg_cpu->pccg_policy->tunables;
+	struct task_struct *curr;
+	unsigned long cap;
+
+	if (!tunables->bore_boost_max_score)
+		return;
+
+	curr = READ_ONCE(cpu_rq(pccg_cpu->cpu)->curr);
+	if (!curr || is_idle_task(curr) ||
+	    (curr->se.burst_penalty >> 8) > tunables->bore_boost_max_score)
+		return;
+
+	cap = arch_scale_cpu_capacity(pccg_cpu->cpu);
+	pccg_hispeed_raise(pccg_cpu, time_ns, pccg_target_util(pccg_cpu, cap));
+}
+#else
+static inline void pccg_bore_check(struct pccg_cpu *pccg_cpu, u64 time_ns) {}
+#endif
+
+/*
+ * pccg_wake_edge_check() - self-sufficient primary trigger: fire the floor
+ * the instant this CPU's rq->nr_running goes from 0 to nonzero.
+ *
+ * This needs nothing beyond what every Linux scheduler build already
+ * maintains unconditionally -- no BORE, no NO_HZ idle-call accounting, no
+ * EAS. A CPU with rq->nr_running == 0 has nothing runnable queued (it is,
+ * or is about to go, idle); the transition to nonzero is the earliest
+ * possible point at which "this CPU just became busy" can be known at
+ * all, strictly earlier than either the idle-time window (which needs a
+ * full hispeed_window_us to confirm it) or even BORE's burst_penalty
+ * (which needs the task to have actually been picked and started running
+ * first). This is what makes PCCG work without depending on anything else
+ * SAGA ships -- BORE and the idle-time path only add extra corroboration
+ * on top when they're present.
+ */
+static void pccg_wake_edge_check(struct pccg_cpu *pccg_cpu, u64 time_ns)
+{
+	struct pccg_tunables *tunables = pccg_cpu->pccg_policy->tunables;
+	unsigned int nr_running = cpu_rq(pccg_cpu->cpu)->nr_running;
+
+	if (tunables->wake_edge_boost && !pccg_cpu->prev_nr_running && nr_running) {
+		unsigned long cap = arch_scale_cpu_capacity(pccg_cpu->cpu);
+
+		pccg_hispeed_raise(pccg_cpu, time_ns, pccg_target_util(pccg_cpu, cap));
+	}
+	pccg_cpu->prev_nr_running = nr_running;
+}
+
+static void pccg_get_util(struct pccg_cpu *pccg_cpu, u64 time)
+{
+	struct rq *rq = cpu_rq(pccg_cpu->cpu);
+
+	pccg_cpu->max = arch_scale_cpu_capacity(pccg_cpu->cpu);
+	pccg_cpu->bw_dl = cpu_bw_dl(rq);
+	pccg_cpu->util = effective_cpu_util(pccg_cpu->cpu, cpu_util_cfs(pccg_cpu->cpu),
+					   FREQUENCY_UTIL, NULL);
+
+	pccg_update_hispeed(pccg_cpu, time);
+	pccg_wake_edge_check(pccg_cpu, time);
+	pccg_bore_check(pccg_cpu, time);
+	if (pccg_cpu->hispeed_floor > pccg_cpu->util)
+		pccg_cpu->util = pccg_cpu->hispeed_floor;
+}
+
+/* IO-wait boost: unchanged from schedutil, reused as-is (already correct
+ * and already proven on this exact tree). */
+static bool pccg_iowait_reset(struct pccg_cpu *pccg_cpu, u64 time,
+			      bool set_iowait_boost)
+{
+	s64 delta_ns = time - pccg_cpu->last_update;
+
+	if (delta_ns <= TICK_NSEC)
+		return false;
+
+	pccg_cpu->iowait_boost = set_iowait_boost ? IOWAIT_BOOST_MIN : 0;
+	pccg_cpu->iowait_boost_pending = set_iowait_boost;
+
+	return true;
+}
+
+static void pccg_iowait_boost(struct pccg_cpu *pccg_cpu, u64 time,
+			      unsigned int flags)
+{
+	bool set_iowait_boost = flags & SCHED_CPUFREQ_IOWAIT;
+
+	if (pccg_cpu->iowait_boost &&
+	    pccg_iowait_reset(pccg_cpu, time, set_iowait_boost))
+		return;
+
+	if (!set_iowait_boost)
+		return;
+
+	if (pccg_cpu->iowait_boost_pending)
+		return;
+	pccg_cpu->iowait_boost_pending = true;
+
+	if (pccg_cpu->iowait_boost) {
+		pccg_cpu->iowait_boost =
+			min_t(unsigned int, pccg_cpu->iowait_boost << 1, SCHED_CAPACITY_SCALE);
+		return;
+	}
+
+	pccg_cpu->iowait_boost = IOWAIT_BOOST_MIN;
+}
+
+static void pccg_iowait_apply(struct pccg_cpu *pccg_cpu, u64 time)
+{
+	unsigned long boost;
+
+	if (!pccg_cpu->iowait_boost)
+		return;
+
+	if (pccg_iowait_reset(pccg_cpu, time, false))
+		return;
+
+	if (!pccg_cpu->iowait_boost_pending) {
+		pccg_cpu->iowait_boost >>= 1;
+		if (pccg_cpu->iowait_boost < IOWAIT_BOOST_MIN) {
+			pccg_cpu->iowait_boost = 0;
+			return;
+		}
+	}
+
+	pccg_cpu->iowait_boost_pending = false;
+
+	boost = (pccg_cpu->iowait_boost * pccg_cpu->max) >> SCHED_CAPACITY_SHIFT;
+	boost = uclamp_rq_util_with(cpu_rq(pccg_cpu->cpu), boost, NULL);
+	if (pccg_cpu->util < boost)
+		pccg_cpu->util = boost;
+}
+
+#ifdef CONFIG_NO_HZ_COMMON
+static bool pccg_cpu_is_busy(struct pccg_cpu *pccg_cpu)
+{
+	unsigned long idle_calls = tick_nohz_get_idle_calls_cpu(pccg_cpu->cpu);
+	bool ret = idle_calls == pccg_cpu->saved_idle_calls;
+
+	pccg_cpu->saved_idle_calls = idle_calls;
+	return ret;
+}
+#else
+static inline bool pccg_cpu_is_busy(struct pccg_cpu *pccg_cpu) { return false; }
+#endif
+
+static inline void pccg_ignore_dl_rate_limit(struct pccg_cpu *pccg_cpu)
+{
+	if (cpu_bw_dl(cpu_rq(pccg_cpu->cpu)) > pccg_cpu->bw_dl)
+		WRITE_ONCE(pccg_cpu->pccg_policy->limits_changed, true);
+}
+
+static inline bool pccg_update_single_common(struct pccg_cpu *pccg_cpu,
+					     u64 time, unsigned int flags)
+{
+	pccg_iowait_boost(pccg_cpu, time, flags);
+	pccg_cpu->last_update = time;
+
+	pccg_ignore_dl_rate_limit(pccg_cpu);
+
+	if (!pccg_should_update_freq(pccg_cpu->pccg_policy, time))
+		return false;
+
+	pccg_get_util(pccg_cpu, time);
+	pccg_iowait_apply(pccg_cpu, time);
+
+	return true;
+}
+
+static void pccg_update_single_freq(struct update_util_data *hook, u64 time,
+				    unsigned int flags)
+{
+	struct pccg_cpu *pccg_cpu = container_of(hook, struct pccg_cpu, update_util);
+	struct pccg_policy *pccg_policy = pccg_cpu->pccg_policy;
+	unsigned int cached_freq = pccg_policy->cached_raw_freq;
+	unsigned int next_f;
+
+	if (!pccg_update_single_common(pccg_cpu, time, flags))
+		return;
+
+	next_f = pccg_get_next_freq(pccg_policy, pccg_cpu->util, pccg_cpu->max);
+
+	/* Same "don't drop early" guard as schedutil, but the hispeed floor
+	 * already covers the fast-response side of that trade-off, so this
+	 * mainly protects against a single idle sample racing the floor's
+	 * decay. */
+	if (!uclamp_rq_is_capped(cpu_rq(pccg_cpu->cpu)) &&
+	    pccg_cpu_is_busy(pccg_cpu) && next_f < pccg_policy->next_freq &&
+	    !pccg_policy->need_freq_update) {
+		next_f = pccg_policy->next_freq;
+		pccg_policy->cached_raw_freq = cached_freq;
+	}
+
+	if (!pccg_update_next_freq(pccg_policy, time, next_f))
+		return;
+
+	if (pccg_policy->policy->fast_switch_enabled) {
+		cpufreq_driver_fast_switch(pccg_policy->policy, next_f);
+	} else {
+		raw_spin_lock(&pccg_policy->update_lock);
+		pccg_deferred_update(pccg_policy);
+		raw_spin_unlock(&pccg_policy->update_lock);
+	}
+}
+
+static void pccg_update_single_perf(struct update_util_data *hook, u64 time,
+				    unsigned int flags)
+{
+	struct pccg_cpu *pccg_cpu = container_of(hook, struct pccg_cpu, update_util);
+	unsigned long prev_util = pccg_cpu->util;
+
+	if (!arch_scale_freq_invariant()) {
+		pccg_update_single_freq(hook, time, flags);
+		return;
+	}
+
+	if (!pccg_update_single_common(pccg_cpu, time, flags))
+		return;
+
+	if (!uclamp_rq_is_capped(cpu_rq(pccg_cpu->cpu)) &&
+	    pccg_cpu_is_busy(pccg_cpu) && pccg_cpu->util < prev_util)
+		pccg_cpu->util = prev_util;
+
+	cpufreq_driver_adjust_perf(pccg_cpu->cpu, map_util_perf(pccg_cpu->bw_dl),
+				   map_util_perf(pccg_cpu->util), pccg_cpu->max);
+
+	pccg_cpu->pccg_policy->last_freq_update_time = time;
+}
+
+static unsigned int pccg_next_freq_shared(struct pccg_cpu *pccg_cpu, u64 time)
+{
+	struct pccg_policy *pccg_policy = pccg_cpu->pccg_policy;
+	struct cpufreq_policy *policy = pccg_policy->policy;
+	unsigned long util = 0, max = 1;
+	unsigned int j;
+
+	for_each_cpu(j, policy->cpus) {
+		struct pccg_cpu *j_pccg_cpu = &per_cpu(pccg_cpu_data, j);
+		unsigned long j_util, j_max;
+
+		pccg_get_util(j_pccg_cpu, time);
+		pccg_iowait_apply(j_pccg_cpu, time);
+		j_util = j_pccg_cpu->util;
+		j_max = j_pccg_cpu->max;
+
+		if (j_util * max > j_max * util) {
+			util = j_util;
+			max = j_max;
+		}
+	}
+
+	return pccg_get_next_freq(pccg_policy, util, max);
+}
+
+static void
+pccg_update_shared(struct update_util_data *hook, u64 time, unsigned int flags)
+{
+	struct pccg_cpu *pccg_cpu = container_of(hook, struct pccg_cpu, update_util);
+	struct pccg_policy *pccg_policy = pccg_cpu->pccg_policy;
+	unsigned int next_f;
+
+	raw_spin_lock(&pccg_policy->update_lock);
+
+	pccg_iowait_boost(pccg_cpu, time, flags);
+	pccg_cpu->last_update = time;
+
+	pccg_ignore_dl_rate_limit(pccg_cpu);
+
+	if (pccg_should_update_freq(pccg_policy, time)) {
+		next_f = pccg_next_freq_shared(pccg_cpu, time);
+
+		if (!pccg_update_next_freq(pccg_policy, time, next_f))
+			goto unlock;
+
+		if (pccg_policy->policy->fast_switch_enabled)
+			cpufreq_driver_fast_switch(pccg_policy->policy, next_f);
+		else
+			pccg_deferred_update(pccg_policy);
+	}
+unlock:
+	raw_spin_unlock(&pccg_policy->update_lock);
+}
+
+static void pccg_work(struct kthread_work *work)
+{
+	struct pccg_policy *pccg_policy = container_of(work, struct pccg_policy, work);
+	unsigned int freq;
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&pccg_policy->update_lock, flags);
+	freq = pccg_policy->next_freq;
+	pccg_policy->work_in_progress = false;
+	raw_spin_unlock_irqrestore(&pccg_policy->update_lock, flags);
+
+	mutex_lock(&pccg_policy->work_lock);
+	__cpufreq_driver_target(pccg_policy->policy, freq, CPUFREQ_RELATION_L);
+	mutex_unlock(&pccg_policy->work_lock);
+}
+
+static void pccg_irq_work(struct irq_work *irq_work)
+{
+	struct pccg_policy *pccg_policy;
+
+	pccg_policy = container_of(irq_work, struct pccg_policy, irq_work);
+
+	kthread_queue_work(&pccg_policy->worker, &pccg_policy->work);
+}
+
+/************************** sysfs interface ************************/
+
+static struct pccg_tunables *pccg_global_tunables;
+static DEFINE_MUTEX(pccg_global_tunables_lock);
+
+static inline struct pccg_tunables *to_pccg_tunables(struct gov_attr_set *attr_set)
+{
+	return container_of(attr_set, struct pccg_tunables, attr_set);
+}
+
+#define pccg_attr_show(_name)						\
+static ssize_t pccg_##_name##_show(struct gov_attr_set *attr_set, char *buf) \
+{									\
+	struct pccg_tunables *tunables = to_pccg_tunables(attr_set);	\
+	return sprintf(buf, "%u\n", tunables->_name);			\
+}
+
+#define pccg_attr_store_uint(_name, _min, _max)			\
+static ssize_t pccg_##_name##_store(struct gov_attr_set *attr_set,	\
+			      const char *buf, size_t count)		\
+{									\
+	struct pccg_tunables *tunables = to_pccg_tunables(attr_set);	\
+	unsigned int val;						\
+	if (kstrtouint(buf, 10, &val))					\
+		return -EINVAL;						\
+	if (val < (_min) || val > (_max))				\
+		return -EINVAL;						\
+	tunables->_name = val;						\
+	return count;							\
+}
+
+/* Every one of these is built by hand rather than via __ATTR_RW(name),
+ * which would tie the sysfs filename to the C function names via token
+ * pasting -- and pccg_attr_show()/_store() above deliberately generate
+ * pccg_<name>_show/_store, not <name>_show/_store, because
+ * cpufreq_reflex.c already defines plain <name>_show/_store for the same
+ * tunable names and both files land in the same translation unit
+ * (build_utility.c #includes both). Building the struct manually keeps
+ * the sysfs files named exactly like REFLEX's (hispeed_window_us, etc.)
+ * while the backing C symbols stay distinct per file. */
+#define PCCG_ATTR(_name) \
+static struct governor_attr _name##_attr = {	\
+	.attr	= { .name = #_name, .mode = 0644 },	\
+	.show	= pccg_##_name##_show,			\
+	.store	= pccg_##_name##_store,			\
+}
+
+pccg_attr_show(hispeed_window_us);
+pccg_attr_store_uint(hispeed_window_us, 500, 50000);
+PCCG_ATTR(hispeed_window_us);
+
+pccg_attr_show(hispeed_load_pct);
+pccg_attr_store_uint(hispeed_load_pct, 1, 100);
+PCCG_ATTR(hispeed_load_pct);
+
+pccg_attr_show(hispeed_freq_pct);
+pccg_attr_store_uint(hispeed_freq_pct, 1, 100);
+PCCG_ATTR(hispeed_freq_pct);
+
+pccg_attr_show(hispeed_decay_shift);
+pccg_attr_store_uint(hispeed_decay_shift, 1, 6);
+PCCG_ATTR(hispeed_decay_shift);
+
+pccg_attr_show(hispeed_hold_us);
+pccg_attr_store_uint(hispeed_hold_us, 0, 100000);
+PCCG_ATTR(hispeed_hold_us);
+
+pccg_attr_show(wake_edge_boost);
+pccg_attr_store_uint(wake_edge_boost, 0, 1);
+PCCG_ATTR(wake_edge_boost);
+
+pccg_attr_show(auto_capacity_scale);
+pccg_attr_store_uint(auto_capacity_scale, 0, 1);
+PCCG_ATTR(auto_capacity_scale);
+
+#ifdef CONFIG_SCHED_BORE
+pccg_attr_show(bore_boost_max_score);
+pccg_attr_store_uint(bore_boost_max_score, 0, 39);
+PCCG_ATTR(bore_boost_max_score);
+#endif
+
+#undef pccg_attr_show
+#undef pccg_attr_store_uint
+#undef PCCG_ATTR
+
+static ssize_t pccg_rate_limit_us_show(struct gov_attr_set *attr_set, char *buf)
+{
+	struct pccg_tunables *tunables = to_pccg_tunables(attr_set);
+
+	return sprintf(buf, "%u\n", tunables->rate_limit_us);
+}
+
+static ssize_t
+pccg_rate_limit_us_store(struct gov_attr_set *attr_set, const char *buf, size_t count)
+{
+	struct pccg_tunables *tunables = to_pccg_tunables(attr_set);
+	struct pccg_policy *pccg_policy;
+	unsigned int rate_limit_us;
+
+	if (kstrtouint(buf, 10, &rate_limit_us))
+		return -EINVAL;
+
+	tunables->rate_limit_us = rate_limit_us;
+
+	list_for_each_entry(pccg_policy, &attr_set->policy_list, tunables_hook)
+		pccg_policy->freq_update_delay_ns = rate_limit_us * NSEC_PER_USEC;
+
+	return count;
+}
+
+/* Deliberately NOT using __ATTR_RW(rate_limit_us) here: that macro ties
+ * the sysfs filename to the C function names via token pasting, and
+ * pccg_rate_limit_us_show/_store are already renamed (see above) to avoid
+ * colliding with schedutil's own rate_limit_us_show/_store — both files
+ * live in the same translation unit (build_utility.c #includes both).
+ * Building the struct by hand keeps the sysfs file named "rate_limit_us"
+ * (matching schedutil's tunable, as documented in the addon) while the
+ * backing C symbols stay distinct. */
+static struct governor_attr pccg_rate_limit_us = {
+	.attr	= { .name = "rate_limit_us", .mode = 0644 },
+	.show	= pccg_rate_limit_us_show,
+	.store	= pccg_rate_limit_us_store,
+};
+
+static struct attribute *pccg_attrs[] = {
+	&pccg_rate_limit_us.attr,
+	&hispeed_window_us_attr.attr,
+	&hispeed_load_pct_attr.attr,
+	&hispeed_freq_pct_attr.attr,
+	&hispeed_decay_shift_attr.attr,
+	&hispeed_hold_us_attr.attr,
+	&wake_edge_boost_attr.attr,
+	&auto_capacity_scale_attr.attr,
+#ifdef CONFIG_SCHED_BORE
+	&bore_boost_max_score_attr.attr,
+#endif
+	NULL
+};
+ATTRIBUTE_GROUPS(pccg);
+
+static void pccg_tunables_free(struct kobject *kobj)
+{
+	struct gov_attr_set *attr_set = to_gov_attr_set(kobj);
+
+	kfree(to_pccg_tunables(attr_set));
+}
+
+static struct kobj_type pccg_tunables_ktype = {
+	.default_groups = pccg_groups,
+	.sysfs_ops = &governor_sysfs_ops,
+	.release = &pccg_tunables_free,
+};
+
+/********************** cpufreq governor interface *********************/
+
+struct cpufreq_governor pccg_gov;
+
+static struct pccg_policy *pccg_policy_alloc(struct cpufreq_policy *policy)
+{
+	struct pccg_policy *pccg_policy;
+
+	pccg_policy = kzalloc(sizeof(*pccg_policy), GFP_KERNEL);
+	if (!pccg_policy)
+		return NULL;
+
+	pccg_policy->policy = policy;
+	raw_spin_lock_init(&pccg_policy->update_lock);
+	return pccg_policy;
+}
+
+static void pccg_policy_free(struct pccg_policy *pccg_policy)
+{
+	kfree(pccg_policy);
+}
+
+static int pccg_kthread_create(struct pccg_policy *pccg_policy)
+{
+	struct task_struct *thread;
+	struct sched_attr attr = {
+		.size		= sizeof(struct sched_attr),
+		.sched_policy	= SCHED_DEADLINE,
+		.sched_flags	= SCHED_FLAG_SUGOV,
+		.sched_nice	= 0,
+		.sched_priority	= 0,
+		.sched_runtime	=  1000000,
+		.sched_deadline = 10000000,
+		.sched_period	= 10000000,
+	};
+	struct cpufreq_policy *policy = pccg_policy->policy;
+	int ret;
+
+	if (policy->fast_switch_enabled)
+		return 0;
+
+	kthread_init_work(&pccg_policy->work, pccg_work);
+	kthread_init_worker(&pccg_policy->worker);
+	thread = kthread_create(kthread_worker_fn, &pccg_policy->worker,
+				"pccg:%d",
+				cpumask_first(policy->related_cpus));
+	if (IS_ERR(thread)) {
+		pr_err("pccg: failed to create thread: %ld\n", PTR_ERR(thread));
+		return PTR_ERR(thread);
+	}
+
+	ret = sched_setattr_nocheck(thread, &attr);
+	if (ret) {
+		kthread_stop(thread);
+		pr_warn("pccg: failed to set SCHED_DEADLINE\n");
+		return ret;
+	}
+
+	pccg_policy->thread = thread;
+	kthread_bind_mask(thread, policy->related_cpus);
+	init_irq_work(&pccg_policy->irq_work, pccg_irq_work);
+	mutex_init(&pccg_policy->work_lock);
+
+	wake_up_process(thread);
+
+	return 0;
+}
+
+static void pccg_kthread_stop(struct pccg_policy *pccg_policy)
+{
+	if (pccg_policy->policy->fast_switch_enabled)
+		return;
+
+	kthread_flush_worker(&pccg_policy->worker);
+	kthread_stop(pccg_policy->thread);
+	mutex_destroy(&pccg_policy->work_lock);
+}
+
+static struct pccg_tunables *pccg_tunables_alloc(struct pccg_policy *pccg_policy)
+{
+	struct pccg_tunables *tunables;
+
+	tunables = kzalloc(sizeof(*tunables), GFP_KERNEL);
+	if (tunables) {
+		gov_attr_set_init(&tunables->attr_set, &pccg_policy->tunables_hook);
+		if (!have_governor_per_policy())
+			pccg_global_tunables = tunables;
+	}
+	return tunables;
+}
+
+static void pccg_clear_global_tunables(void)
+{
+	if (!have_governor_per_policy())
+		pccg_global_tunables = NULL;
+}
+
+static int pccg_init(struct cpufreq_policy *policy)
+{
+	struct pccg_policy *pccg_policy;
+	struct pccg_tunables *tunables;
+	int ret = 0;
+
+	if (policy->governor_data)
+		return -EBUSY;
+
+	cpufreq_enable_fast_switch(policy);
+
+	pccg_policy = pccg_policy_alloc(policy);
+	if (!pccg_policy) {
+		ret = -ENOMEM;
+		goto disable_fast_switch;
+	}
+
+	ret = pccg_kthread_create(pccg_policy);
+	if (ret)
+		goto free_pccg_policy;
+
+	mutex_lock(&pccg_global_tunables_lock);
+
+	if (pccg_global_tunables) {
+		if (WARN_ON(have_governor_per_policy())) {
+			ret = -EINVAL;
+			goto stop_kthread;
+		}
+		policy->governor_data = pccg_policy;
+		pccg_policy->tunables = pccg_global_tunables;
+
+		gov_attr_set_get(&pccg_global_tunables->attr_set, &pccg_policy->tunables_hook);
+		goto out;
+	}
+
+	tunables = pccg_tunables_alloc(pccg_policy);
+	if (!tunables) {
+		ret = -ENOMEM;
+		goto stop_kthread;
+	}
+
+	tunables->rate_limit_us = cpufreq_policy_transition_delay_us(policy);
+	/* "Go all in" defaults -- see struct pccg_tunables for the
+	 * reasoning behind each one; every value is re-tunable at runtime
+	 * per policy/cluster regardless of these starting points. */
+	tunables->hispeed_window_us   = 8000;
+	tunables->hispeed_load_pct    = 90;
+	/* Full jump on trigger (vs REFLEX's gentler 70) -- tempered per-CPU
+	 * by auto_capacity_scale below rather than by a flat lower default. */
+	tunables->hispeed_freq_pct    = 100;
+	tunables->hispeed_decay_shift = 1;
+	/* 16ms hold: survives a typical gap between scroll-gesture touch
+	 * events without letting the floor free-run forever on a single
+	 * trigger (each fresh trigger still pushes the hold window out,
+	 * see pccg_hispeed_raise()). */
+	tunables->hispeed_hold_us     = 16000;
+	/* Self-sufficient primary trigger, on by default -- this is what
+	 * makes PCCG work with nothing else present. */
+	tunables->wake_edge_boost     = 1;
+	tunables->auto_capacity_scale = 1;
+#ifdef CONFIG_SCHED_BORE
+	/* Conservative: only scores 0-2 (freshly-woken tasks and kthreads,
+	 * per BORE's own classification) trigger early. 0 disables this
+	 * path outright if kthread-triggered snaps turn out unwanted on a
+	 * given device. Redundant with wake_edge_boost in the common case;
+	 * see the field comment in struct pccg_tunables for when it isn't. */
+	tunables->bore_boost_max_score = 2;
+#endif
+
+	policy->governor_data = pccg_policy;
+	pccg_policy->tunables = tunables;
+
+	ret = kobject_init_and_add(&tunables->attr_set.kobj, &pccg_tunables_ktype,
+				   get_governor_parent_kobj(policy), "%s",
+				   pccg_gov.name);
+	if (ret)
+		goto fail;
+
+out:
+	mutex_unlock(&pccg_global_tunables_lock);
+	return 0;
+
+fail:
+	kobject_put(&tunables->attr_set.kobj);
+	policy->governor_data = NULL;
+	pccg_clear_global_tunables();
+
+stop_kthread:
+	pccg_kthread_stop(pccg_policy);
+	mutex_unlock(&pccg_global_tunables_lock);
+
+free_pccg_policy:
+	pccg_policy_free(pccg_policy);
+
+disable_fast_switch:
+	cpufreq_disable_fast_switch(policy);
+
+	pr_err("pccg: initialization failed (error %d)\n", ret);
+	return ret;
+}
+
+static void pccg_exit(struct cpufreq_policy *policy)
+{
+	struct pccg_policy *pccg_policy = policy->governor_data;
+	struct pccg_tunables *tunables = pccg_policy->tunables;
+	unsigned int count;
+
+	mutex_lock(&pccg_global_tunables_lock);
+
+	count = gov_attr_set_put(&tunables->attr_set, &pccg_policy->tunables_hook);
+	policy->governor_data = NULL;
+	if (!count)
+		pccg_clear_global_tunables();
+
+	mutex_unlock(&pccg_global_tunables_lock);
+
+	pccg_kthread_stop(pccg_policy);
+	pccg_policy_free(pccg_policy);
+	cpufreq_disable_fast_switch(policy);
+}
+
+static int pccg_start(struct cpufreq_policy *policy)
+{
+	struct pccg_policy *pccg_policy = policy->governor_data;
+	void (*uu)(struct update_util_data *data, u64 time, unsigned int flags);
+	unsigned int cpu;
+	u64 now = ktime_get_ns();
+
+	pccg_policy->freq_update_delay_ns	= pccg_policy->tunables->rate_limit_us * NSEC_PER_USEC;
+	pccg_policy->last_freq_update_time	= 0;
+	pccg_policy->next_freq			= 0;
+	pccg_policy->work_in_progress		= false;
+	pccg_policy->limits_changed		= false;
+	pccg_policy->cached_raw_freq		= 0;
+
+	pccg_policy->need_freq_update = cpufreq_driver_test_flags(CPUFREQ_NEED_UPDATE_LIMITS);
+
+	for_each_cpu(cpu, policy->cpus) {
+		struct pccg_cpu *pccg_cpu = &per_cpu(pccg_cpu_data, cpu);
+
+		memset(pccg_cpu, 0, sizeof(*pccg_cpu));
+		pccg_cpu->cpu			= cpu;
+		pccg_cpu->pccg_policy		= pccg_policy;
+		/* Seed the idle-time baseline so the first hispeed sample
+		 * measures a real window instead of "since CPU boot". */
+		pccg_cpu->hispeed_prev_idle_time = get_cpu_idle_time(cpu,
+					&pccg_cpu->hispeed_prev_wall_time, 0);
+		pccg_cpu->hispeed_next_sample_time = now +
+			(u64)pccg_policy->tunables->hispeed_window_us * NSEC_PER_USEC;
+	}
+
+	if (policy_is_shared(policy))
+		uu = pccg_update_shared;
+	else if (policy->fast_switch_enabled && cpufreq_driver_has_adjust_perf())
+		uu = pccg_update_single_perf;
+	else
+		uu = pccg_update_single_freq;
+
+	for_each_cpu(cpu, policy->cpus) {
+		struct pccg_cpu *pccg_cpu = &per_cpu(pccg_cpu_data, cpu);
+
+		cpufreq_add_update_util_hook(cpu, &pccg_cpu->update_util, uu);
+	}
+	return 0;
+}
+
+static void pccg_stop(struct cpufreq_policy *policy)
+{
+	struct pccg_policy *pccg_policy = policy->governor_data;
+	unsigned int cpu;
+
+	for_each_cpu(cpu, policy->cpus)
+		cpufreq_remove_update_util_hook(cpu);
+
+	synchronize_rcu();
+
+	if (!policy->fast_switch_enabled) {
+		irq_work_sync(&pccg_policy->irq_work);
+		kthread_cancel_work_sync(&pccg_policy->work);
+	}
+}
+
+static void pccg_limits(struct cpufreq_policy *policy)
+{
+	struct pccg_policy *pccg_policy = policy->governor_data;
+
+	if (!policy->fast_switch_enabled) {
+		mutex_lock(&pccg_policy->work_lock);
+		cpufreq_policy_apply_limits(policy);
+		mutex_unlock(&pccg_policy->work_lock);
+	}
+
+	smp_wmb();
+
+	WRITE_ONCE(pccg_policy->limits_changed, true);
+}
+
+struct cpufreq_governor pccg_gov = {
+	.name			= "pccg",
+	.owner			= THIS_MODULE,
+	.flags			= CPUFREQ_GOV_DYNAMIC_SWITCHING,
+	.init			= pccg_init,
+	.exit			= pccg_exit,
+	.start			= pccg_start,
+	.stop			= pccg_stop,
+	.limits			= pccg_limits,
+};
+
+#ifdef CONFIG_CPU_FREQ_DEFAULT_GOV_PCCG
+struct cpufreq_governor *cpufreq_default_governor(void)
+{
+	return &pccg_gov;
+}
+#endif
+
+cpufreq_governor_init(pccg_gov);
