+#ifdef CONFIG_SCHED_BORE
+#define MAX_BURST_PENALTY ((40U << 8) - 1)
+
+static inline u32 log2p1_u64_u32fp(u64 v, u8 fp)
+{
+	int clz, exponent;
+	u32 mantissa;
+
+	if (unlikely(!v))
+		return 0;
+	clz = __builtin_clzll(v);
+	exponent = 64 - clz;
+	mantissa = (u32)((v << clz) << 1 >> (64 - fp));
+	return exponent << fp | mantissa;
+}
+
+static inline u32 calc_burst_penalty(u64 burst_time)
+{
+	u32 greed, tolerance, penalty, scaled_penalty;
+	s32 diff, overflow;
+
+	greed = log2p1_u64_u32fp(burst_time, 8);
+	tolerance = sched_burst_penalty_offset << 8;
+	diff = (s32)(greed - tolerance);
+	penalty = diff & ~(diff >> 31);
+	scaled_penalty = penalty * sched_burst_penalty_scale >> 10;
+	overflow = scaled_penalty - MAX_BURST_PENALTY;
+	return scaled_penalty - (overflow & ~(overflow >> 31));
+}
+
+/*
+ * True when the task's cgroup has been marked latency-sensitive by
+ * userspace (Android sets this for the top-app cgroup via the
+ * cpu.uclamp.latency_sensitive cgroup file). Returns false, not an
+ * error, whenever the field isn't compiled in or the task has no
+ * group -- callers treat "unknown" the same as "not top-app".
+ */
+#ifdef CONFIG_UCLAMP_TASK_GROUP
+static inline bool bore_topapp_boosted(struct task_struct *p)
+{
+	struct task_group *tg = task_group(p);
+
+	return tg && tg->latency_sensitive;
+}
+#else
+static inline bool bore_topapp_boosted(struct task_struct *p)
+{
+	return false;
+}
+#endif
+
+static inline u8 effective_prio(struct task_struct *p)
+{
+	u8 prio = p->static_prio - MAX_RT_PRIO;
+
+	if (likely(sched_bore)) {
+		u8 penalty = p->se.burst_penalty >> 8;
+
+		if (sched_bore_topapp_discount && bore_topapp_boosted(p))
+			penalty -= min_t(u8, penalty, sched_bore_topapp_discount);
+
+		prio += penalty;
+	}
+
+	return min_t(u8, 39, prio);
+}
+
+static inline u32 binary_smooth(u32 new, u32 old, u8 extra_shift)
+{
+	u32 is_growing = (new > old);
+	u32 increment = (new - old) * is_growing;
+	u32 shift = sched_burst_smoothness + extra_shift;
+	u32 smoothed = old + ((increment + (1U << shift) - 1) >> shift);
+
+	return (new & ~(-is_growing)) | (smoothed & (-is_growing));
+}
