diff --git a/drivers/cpufreq/Kconfig b/drivers/cpufreq/Kconfig
index c93954613..a8457b0c8 100644
--- a/drivers/cpufreq/Kconfig
+++ b/drivers/cpufreq/Kconfig
@@ -115,6 +115,24 @@ config CPU_FREQ_DEFAULT_GOV_SCHEDUTIL
 
 endchoice
 
+config SAGA_FORCE_SCHEDUTIL
+	bool "SAGA: force default governor on every online/hotplug/resume"
+	depends on CPU_FREQ_GOV_SCHEDUTIL
+	default n
+	help
+	  Re-applies the compile-time default CPUFreq governor every time a
+	  policy comes online (boot, CPU hotplug, suspend/resume), instead
+	  of restoring the governor that was active before the CPU went
+	  offline. Defends against a vendor init.rc/HAL script overriding
+	  scaling_governor at boot, where that override would otherwise
+	  become the new "last governor" and get faithfully restored right
+	  back on the next hotplug or resume cycle.
+
+	  Does NOT block a live scaling_governor write to a policy that
+	  stays online the whole time (e.g. a kernel manager app, or a HAL
+	  that writes without ever offlining the CPU) -- only the
+	  online/hotplug/resume path is covered. If unsure, say N.
+
 config CPU_FREQ_GOV_PERFORMANCE
 	tristate "'performance' governor"
 	help
diff --git a/drivers/cpufreq/cpufreq.c b/drivers/cpufreq/cpufreq.c
index 0579b7eac..72f9e3925 100644
--- a/drivers/cpufreq/cpufreq.c
+++ b/drivers/cpufreq/cpufreq.c
@@ -1076,6 +1076,17 @@ static int cpufreq_init_policy(struct cpufreq_policy *policy)
 	int ret;
 
 	if (has_target()) {
+#ifdef CONFIG_SAGA_FORCE_SCHEDUTIL
+		/*
+		 * Always re-apply the compile-time default governor instead
+		 * of restoring policy->last_governor -- see the Kconfig help
+		 * text for SAGA_FORCE_SCHEDUTIL for why (defends against a
+		 * vendor init.rc/HAL override surviving as the new
+		 * "last governor" across a hotplug/resume cycle).
+		 */
+		gov = cpufreq_default_governor();
+		__module_get(gov->owner);
+#else
 		/* Update policy governor to the one used before hotplug. */
 		gov = get_governor(policy->last_governor);
 		if (gov) {
@@ -1089,6 +1100,7 @@ static int cpufreq_init_policy(struct cpufreq_policy *policy)
 			gov = cpufreq_default_governor();
 			__module_get(gov->owner);
 		}
+#endif
 
 	} else {
 
