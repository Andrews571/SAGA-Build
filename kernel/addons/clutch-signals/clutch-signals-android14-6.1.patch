diff --git a/block/Kconfig.iosched b/block/Kconfig.iosched
index 6155161..af3262a 100644
--- a/block/Kconfig.iosched
+++ b/block/Kconfig.iosched
@@ -43,4 +43,23 @@ config BFQ_CGROUP_DEBUG
 	Enable some debugging help. Currently it exports additional stat
 	files in a cgroup which can be useful for debugging.
 
+config CLUTCH_SIGNALS
+	bool "Cross-subsystem Clutch signals (ADIOS <-> CC governor)"
+	default y if MQ_IOSCHED_ADIOS && CPU_FREQ_GOV_CC
+	default n
+	help
+	  Lightweight cross-subsystem signals between the ADIOS I/O
+	  scheduler and the Cerebral Clutch CPU governor. When enabled,
+	  ADIOS reports I/O pressure and top-app activity (~100ms cadence)
+	  and the CC governor reads them to gate iowait boost and, if
+	  configured, confirm wake-edges early. When disabled, all calls
+	  compile to no-ops and neither consumer needs any change.
+
+	  Self-sufficient as an addon: define this symbol here, provide
+	  include/linux/clutch.h and kernel/sched/clutch.c, and both the
+	  ADIOS and CC patches pick it up automatically. Either consumer
+	  can be absent -- the "default y if" expression evaluates to
+	  false when either symbol is undefined, so this addon is inert
+	  in a build that has only one of them.
+
 endmenu
diff --git a/include/linux/clutch.h b/include/linux/clutch.h
new file mode 100644
index 0000000..dff6b58
--- /dev/null
+++ b/include/linux/clutch.h
@@ -0,0 +1,61 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _LINUX_CLUTCH_H
+#define _LINUX_CLUTCH_H
+
+/*
+ * Clutch bridge -- shared, neutral interface between the ADIOS I/O
+ * scheduler (writer: clutch_report_io_pressure()) and the CC_GOVERNOR
+ * cpufreq governor (reader: clutch_get_io_pressure(),
+ * clutch_get_topapp_active()). Storage lives in kernel/sched/clutch.c,
+ * a location neither block/ (ADIOS) nor drivers/cpufreq/ (CC) owns, so
+ * either side can #include this header without a dependency on the
+ * other's source tree.
+ *
+ * This header is written to compile and link safely no matter which of
+ * the two consumers (ADIOS, CC_GOVERNOR) are applied, in any
+ * combination, including none:
+ *
+ *   - CONFIG_CLUTCH_SIGNALS undefined (feature is off): every function
+ *     below is a static inline stub that touches nothing and returns a
+ *     fixed, safe value (0 / false). No real functions exist to link
+ *     against, and none are needed -- callers on both sides always
+ *     compile.
+ *   - CONFIG_CLUTCH_SIGNALS=y (this addon is applied): the real,
+ *     atomic-backed implementation is used instead, declared (not
+ *     defined) here and exported via EXPORT_SYMBOL_GPL from clutch.c.
+ *
+ * Neither consumer needs to wrap call sites in #ifdef CONFIG_CLUTCH_SIGNALS
+ * themselves -- that's handled once, here.
+ *
+ * Memory pressure (clutch_report_memory_pressure() /
+ * clutch_get_memory_pressure()) follows the same rule but has a
+ * different writer: the memory subsystem itself (kswapd, direct
+ * reclaim, ...), not ADIOS. ADIOS never calls the report function --
+ * it only ever #includes this header. Kept in the same header/file
+ * pair as the I/O pressure signals since the ownership role (neutral
+ * storage neither consumer owns) is identical.
+ */
+
+#include <linux/types.h>
+
+#ifdef CONFIG_CLUTCH_SIGNALS
+
+void clutch_report_io_pressure(u32 pct_0_100, bool topapp_active);
+u32 clutch_get_io_pressure(void);
+bool clutch_get_topapp_active(void);
+
+void clutch_report_memory_pressure(u32 pct_0_100);
+u32 clutch_get_memory_pressure(void);
+
+#else
+
+static inline void clutch_report_io_pressure(u32 pct_0_100, bool topapp_active) {}
+static inline u32 clutch_get_io_pressure(void) { return 0; }
+static inline bool clutch_get_topapp_active(void) { return false; }
+
+static inline void clutch_report_memory_pressure(u32 pct_0_100) {}
+static inline u32 clutch_get_memory_pressure(void) { return 0; }
+
+#endif /* CONFIG_CLUTCH_SIGNALS */
+
+#endif /* _LINUX_CLUTCH_H */
diff --git a/kernel/sched/Makefile b/kernel/sched/Makefile
index ff1738c..4a47e3d 100644
--- a/kernel/sched/Makefile
+++ b/kernel/sched/Makefile
@@ -33,3 +33,8 @@ obj-y += fair.o
 obj-y += build_policy.o
 obj-y += build_utility.o
 obj-$(CONFIG_ANDROID_VENDOR_HOOKS) += vendor_hooks.o
+
+# Clutch bridge (SAGA) -- neutral storage shared between the ADIOS I/O
+# scheduler (writer) and CC_GOVERNOR (reader), see include/linux/clutch.h.
