+/*
+ * bore_warp_preempt() - bounded, hard preemption grant for a freshly-woken
+ * task, independent of (and checked before) the normal soft
+ * wakeup_preempt_entity() vruntime/gran comparison.
+ *
+ * wakeup_preempt_entity() already lets BORE-favoured tasks (lower
+ * effective vruntime from a low burst_penalty) preempt sooner than
+ * vanilla CFS would -- but it is still a *soft* comparison: if 'curr'
+ * also happens to have a low vruntime right now (e.g. it was recently
+ * favoured itself), a genuinely fresh 'pse' can still lose and wait up to
+ * wakeup_gran() or the next tick. This adds a second, independent, hard
+ * guarantee on top: when 'curr' is a relative CPU hog (meaningfully
+ * higher BORE score than 'pse') and 'pse' is fresh, and this cfs_rq
+ * hasn't granted a warp preemption recently, preempt unconditionally.
+ *
+ * The "recently" part is the safety bound: one grant per
+ * sched_bore_warp_us per cfs_rq, not a per-task allowance. Without a
+ * cooldown, a burst of fresh-looking wakeups (e.g. a binder thread pool
+ * waking up together) could each individually qualify and chain
+ * preemptions back-to-back, thrashing the CPU instead of helping it.
+ * With the cooldown, at most one "free" preemption escapes per window --
+ * the same bound shape as the per-bucket warp budget refresh in Apple
+ * XNU's Clutch scheduler this is conceptually modelled on (see the
+ * comment on sched_bore_warp_enabled above for the reference).
+ */
+static bool bore_warp_preempt(struct cfs_rq *cfs_rq, struct sched_entity *se,
+			       struct sched_entity *pse, u64 now)
+{
+	if (!sched_bore_warp_enabled)
+		return false;
+
+	if (now < cfs_rq->bore_warp_deadline)
+		return false;
+
+	if ((pse->burst_penalty >> 8) > sched_bore_warp_max_score)
+		return false;
+
+	/* Require curr to be meaningfully worse, not just "not as fresh":
+	 * two similarly-fresh tasks don't need a forced switch, the normal
+	 * soft check already handles that case fine on its own. */
+	if (se->burst_penalty <= pse->burst_penalty)
+		return false;
+
+	cfs_rq->bore_warp_deadline = now + (u64)sched_bore_warp_us * NSEC_PER_USEC;
+	/* Cross-subsystem hint for PCCG (cpufreq_pccg.c) -- read-and-cleared
+	 * there, not gated by anything else here: if warp is disabled
+	 * (sched_bore_warp_enabled=0) this function returns false above
+	 * before ever reaching this line, so the flag simply never gets
+	 * set and PCCG's consumer is a permanent no-op, with zero extra
+	 * checks needed on the cpufreq side. set_bit() (not a plain
+	 * assignment): PCCG may read/clear this for a remote CPU under a
+	 * shared cpufreq policy without holding *this* CPU's rq lock, see
+	 * the field comment on bore_warp_fired in sched.h. */
+	set_bit(0, &cfs_rq->bore_warp_fired);
+	return true;
+}
+#endif
