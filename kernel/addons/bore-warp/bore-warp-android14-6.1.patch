+/*
+ * SAGA: bounded, hard preemption budget for freshly-woken/interactive
+ * tasks, layered on top of BORE's own (soft, vruntime-based) wakeup
+ * favouritism. Inspired by -- not ported from, this is a from-scratch
+ * reimplementation against 6.1's real CFS internals -- the "root bucket
+ * warp" idea in Apple XNU's Clutch scheduler
+ * (apple-oss-distributions/xnu, doc/scheduler/sched_clutch_edge.md):
+ * a class that is technically behind in scheduling order still gets a
+ * small, periodically-refreshing budget during which it can preempt
+ * outright, bounding worst-case wakeup latency without starving
+ * everything else. See bore_warp_preempt() below for the mechanism.
+ *
+ * Off by default (0) -- deliberately not enabled out of the box. This
+ * touches the single hottest path in the scheduler (every wakeup
+ * preemption decision); it should be turned on and evaluated on its own,
+ * after the rest of the burst-penalty tuning is already trusted, not
+ * silently inherited by every device that enables CONFIG_SCHED_BORE.
+ */
+u8   __read_mostly sched_bore_warp_enabled     = 0;
+/* Max BORE score (0-39) the newly woken task may have to qualify as
+ * "fresh" -- same conservative default as Reflex/PCCG's
+ * bore_boost_max_score, kept independently tunable since the two
+ * mechanisms sit in different subsystems and may want different
+ * sensitivity in practice. */
+u8   __read_mostly sched_bore_warp_max_score   = 2;
+/* Cooldown between warp grants on the same cfs_rq, in microseconds.
+ * Small on purpose: this is a last-resort hard override for when the
+ * soft vruntime-based check isn't enough, not the primary mechanism. */
+unsigned int __read_mostly sched_bore_warp_us  = 2000;
 #endif
 
