 config CPU_FREQ_GOV_PERFORMANCE
@@ -211,6 +221,25 @@ config CPU_FREQ_GOV_SCHEDUTIL
 
 	  If in doubt, say N.
 
+config CPU_FREQ_GOV_REFLEX
+	bool "'reflex' cpufreq policy governor (SAGA)"
+	depends on CPU_FREQ && SMP
+	select CPU_FREQ_GOV_ATTR_SET
+	select IRQ_WORK
+	help
+	  schedutil-derived governor with an added "hispeed floor": a real,
+	  measured busy% (from the same idle-time accounting the ondemand
+	  governor uses) is blended on top of the normal PELT-driven
+	  utilization, so a CPU that goes from idle to genuinely busy jumps
+	  toward a high floor immediately instead of waiting for PELT's
+	  ~32ms ramp-up, then decays back to plain PELT scaling over a few
+	  observation windows. Tunable per policy via sysfs
+	  (hispeed_window_us, hispeed_load_pct, hispeed_freq_pct,
+	  hispeed_decay_shift) — safe to enable alongside schedutil, does
+	  not replace it.
+
+	  If in doubt, say N.
+
 comment "CPU frequency scaling drivers"
 
 config CPUFREQ_DT
