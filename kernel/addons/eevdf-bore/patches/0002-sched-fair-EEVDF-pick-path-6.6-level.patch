+/*
+ * Earliest Eligible Virtual Deadline First
+ *
+ *  1) the task must be eligible (must be owed service)
+ *  2) from those, select the one with the earliest virtual deadline.
+ *
+ * O(log n) thanks to the augmented rb-tree: sorted on vruntime, but also a
+ * heap on deadline via se->min_deadline.
+ */
+static struct sched_entity *__pick_eevdf(struct cfs_rq *cfs_rq)
+{
+	struct rb_node *node = cfs_rq->tasks_timeline.rb_root.rb_node;
+	struct sched_entity *curr = cfs_rq->curr;
+	struct sched_entity *best = NULL;
+	struct sched_entity *best_left = NULL;
+
+	if (curr && (!curr->on_rq || !entity_eligible(cfs_rq, curr)))
+		curr = NULL;
+	best = curr;
+
+	/*
+	 * Once selected, run a task until it either becomes non-eligible or
+	 * until it gets a new slice. See the HACK in set_next_entity().
+	 */
+	if (sched_feat(RUN_TO_PARITY) && curr && curr->vlag == curr->deadline)
+		return curr;
+
+	while (node) {
+		struct sched_entity *se = __node_2_se(node);
+
+		/* If this entity is not eligible, try the left subtree. */
+		if (!entity_eligible(cfs_rq, se)) {
+			node = node->rb_left;
+			continue;
+		}
+
+		/* Heap search eligible trees for the best (min_)deadline. */
+		if (!best || deadline_gt(deadline, best, se))
+			best = se;
+
+		/*
+		 * Every se in a left branch is eligible, keep track of the
+		 * branch with the best min_deadline.
+		 */
+		if (node->rb_left) {
+			struct sched_entity *left = __node_2_se(node->rb_left);
+
+			if (!best_left || deadline_gt(min_deadline, best_left, left))
+				best_left = left;
+
+			/* min_deadline is in the left branch: go to 2nd loop */
+			if (left->min_deadline == se->min_deadline)
+				break;
+		}
+
+		/* min_deadline is at this node, no need to look right */
+		if (se->deadline == se->min_deadline)
+			break;
+
+		/* else min_deadline is in the right branch. */
+		node = node->rb_right;
+	}
+
+	/* We ran into an eligible node which is itself the best. */
+	if (!best_left || (s64)(best_left->min_deadline - best->deadline) > 0)
+		return best;
+
+	/* best_left and all its children are eligible; find deadline == min_deadline */
+	node = &best_left->run_node;
+	while (node) {
+		struct sched_entity *se = __node_2_se(node);
+
+		if (se->deadline == se->min_deadline)
+			return se;
+
+		if (node->rb_left &&
+		    __node_2_se(node->rb_left)->min_deadline == se->min_deadline) {
+			node = node->rb_left;
+			continue;
+		}
+
+		node = node->rb_right;
+	}
+	return NULL;
+}
+
+static struct sched_entity *pick_eevdf(struct cfs_rq *cfs_rq)
+{
+	struct sched_entity *se = __pick_eevdf(cfs_rq);
+
+	if (!se) {
+		struct sched_entity *left = __pick_first_entity(cfs_rq);
+		if (left) {
+			static DEFINE_RATELIMIT_STATE(eevdf_fail_rs, 60 * HZ, 3);
+
+			if (__ratelimit(&eevdf_fail_rs)) {
+				struct sched_entity *curr = cfs_rq->curr;
+
+				pr_err("EEVDF scheduling fail, picking leftmost: nr=%u avg_load=%ld avg_v=%lld key_left=%lld curr_on_rq=%d curr_key=%lld left_elig=%d min_dl=%lld left_dl=%lld\n",
+				       cfs_rq->nr_running, (long)cfs_rq->avg_load,
+				       (long long)cfs_rq->avg_vruntime,
+				       (long long)entity_key(cfs_rq, left),
+				       curr ? curr->on_rq : -1,
+				       curr ? (long long)entity_key(cfs_rq, curr) : 0,
+				       entity_eligible(cfs_rq, left),
+				       (long long)left->min_deadline,
+				       (long long)left->deadline);
+			}
+			return left;
+		}
+	}
+
+	return se;
+}
