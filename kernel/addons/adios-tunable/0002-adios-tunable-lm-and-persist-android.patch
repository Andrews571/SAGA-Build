+		if (val >= (int)ad->other_field) \
+			return -EINVAL; \
+	} else { \
+		if (val <= (int)ad->other_field) \
+			return -EINVAL; \
+	} \
+	WRITE_ONCE(ad->field, val); \
+	return count; \
